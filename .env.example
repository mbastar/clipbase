# Turso database (turso db show clipbase --url / turso db tokens create clipbase)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Raindrop.io API token (app.raindrop.io/settings/integrations -> create app -> test token)
RAINDROP_TOKEN=

# OpenRouter API key (openrouter.ai/keys) — embeddings only; `enrich` still uses
# the authenticated claude CLI and needs no key.
OPENROUTER_API_KEY=

# Optional: where the local embedded replica lives (semantic search reads from
# it). Defaults to ~/.cache/clipbase/replica.db. It is a cache — safe to delete.
CLIPBASE_REPLICA_PATH=
